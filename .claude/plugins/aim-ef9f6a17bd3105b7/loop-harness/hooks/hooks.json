{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "loop-harness: inject ledger + HALT state and the loopctl path.",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py\" session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "description": "loop-harness: gate `git commit` on a green tree-bound stamp and, mid-ticket, a tree-bound reviewer verdict.",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py\" pre-commit-gate"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "description": "loop-harness: block direct edits to harness-written loop state (ledger, stamp).",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py\" state-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "loop-harness: refuse to stop while a ticket is mid-flight with uncommitted work.",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.py\" stop-check"
          }
        ]
      }
    ]
  }
}
