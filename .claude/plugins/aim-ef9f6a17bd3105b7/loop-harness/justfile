# Dev recipes for the plugin repo itself. Consumers use loopctl directly.

# Run the plugin's own gates.
check:
    git add --intent-to-add -A .
    uv run pytest
    uvx prek run --all-files

# Run gates and record the evidence stamp (dogfoods the CLI).
stamp:
    uv run loopctl stamp

# Install loopctl as a standalone CLI on PATH (optional; the plugin path needs no install).
install:
    uv tool install --force .

# Same, but editable — picks up local src changes without reinstalling.
install-editable:
    uv tool install --force --editable .
