# Nomad credentials.
NOMAD_TOKEN=xxxxxx-xxx-xxx-xxxxxx-xxxxxxx
NOMAD_ADDR=http://localstack.local:4646

# Consul credentials.
CONSUL_HTTP_TOKEN=xxxxxx-xxx-xxx-xxxxxx-xxxxxxx
CONSUL_HTTP_ADDR=http://localstack.local:8500

# Vault credentials.
VAULT_TOKEN=xxxxxx-xxx-xxx-xxxxxx-xxxxxxx
VAULT_ADDR=http://localstack.local:8200
VAULT_UNSEAL_KEY_1=xxxxxx-xxxxx-xxxxx-xxxxxxx
VAULT_UNSEAL_KEY_2=xxxxxx-xxxxx-xxxxx-xxxxxxx
VAULT_UNSEAL_KEY_3=xxxxxx-xxxxx-xxxxx-xxxxxxx

# Docker registry credentials.
#  daemon.json will be configured to allow insecure host.
DOCKER_USER=localstack
DOCKER_PASSWORD=xxxxxxxxxx
DOCKER_REGISTRY=localstack.local:5000

# SeaweedFS, for the `s3` mc alias and the aws CLI. The admin key is in Vault:
# vault kv get secret/default/seaweedfs/admin
AWS_ENDPOINT_URL_S3=https://s3.lab.orangecluster.nl
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx

# PostgreSQL credentials.
PGHOST=localstack.local
PGPORT=5432
PGUSER=localstack
PGPASSWORD=xxxxxxxxxxxxx
PGDATABASE=localstack

# Bootstrap-only secrets (initial seeding — stored in Vault after first bootstrap)
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxxx
GITHUB_USER=xxxxxxxx
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
