tmp
.devcontainer/.env
.venv
.cache
.ssh
.graveyard
.claude/settings.local.json
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# Keep prod.tfvars local — real values go in git-ignored files; ship .example copies.
**/vars/prod.tfvars

# Per-ticket loop worktrees are linked checkouts, not content to track.
.loop/worktrees/

# Gate output from `loopctl stamp`: a report about a run, not content.
.loop/stamp-logs/

.DS_Store

.claude
# Track only the project rules that govern tracked content: the .okf/ bundle,
# the docs/ layout, and the Terraform file layout those two cite. Everything
# else under .claude/ stays local.
!/.claude/
/.claude/*
!/.claude/rules/
/.claude/rules/*
!/.claude/rules/okf-bundle.md
!/.claude/rules/docs-layout.md
!/.claude/rules/how-to-skeleton.md
!/.claude/rules/terraform-file-layout.md

# APM dependencies
apm_modules/

# pytest-textual-snapshot writes this on every failing run. It is a report
# about a run, not content: ~900KB of rendered HTML that is stale the moment
# the next run finishes.
cli/snapshot_report.html

# Byte-compiled helpers under scripts/ (importing one for a test leaves these).
__pycache__/

# Ansible Galaxy collections installed locally by ansible-galaxy; vendored
# upstream code, re-created on install, not content.
bootstrap/.ansible/
