{
  "gates": [
    "just pre_commit"
  ],
  "require_review": true,
  "require_eval": true,
  "plans_dir": ".loop/plans",
  "notify_title": "loop harness",
  "max_review_cycles": 3,
  "implementation": {
    "review_passes": [
        {
          "id": "adversarial",
          "agent": "loop-implementation-reviewer",
          "enabled": true
        },
        {
          "id": "documentation",
          "agent": "loop-implementation-doc-reviewer",
          "enabled": true
        }
      ],
      "action_stages": []
  },
  "planning": {
    "review_passes": [
      { "id": "plan-validator", "agent": "loop-plan-reviewer", "enabled": true }
    ]
  }
}
