{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": true
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD"
    },
    "complexity_analyzer_config": {
      "classifier": "decision",
      "keywords": {
        "simple_keywords": [
          "say hi"
        ],
        "medium_keywords": [
          "summarise this"
        ],
        "complex_keywords": [
          "prove this theorem"
        ]
      },
      "decision": {
        "provider": "ollama",
        "model": "clef:cloud"
      }
    },
    "routing_rules": [
      {
        "id": "not-router-passthrough",
        "name": "not-router-passthrough",
        "scope": "global",
        "priority": 0,
        "cel_expression": "virtual_key_name != \"router\"",
        "targets": [
          {
            "weight": 1
          }
        ]
      },
      {
        "id": "router-simple",
        "name": "router-simple",
        "scope": "global",
        "priority": 1,
        "cel_expression": "virtual_key_name == \"router\" && complexity_tier == \"SIMPLE\"",
        "targets": [
          {
            "provider": "ollama",
            "model": "gpt-oss:120b-cloud",
            "weight": 1
          }
        ]
      },
      {
        "id": "router-medium",
        "name": "router-medium",
        "scope": "global",
        "priority": 2,
        "cel_expression": "virtual_key_name == \"router\" && complexity_tier == \"MEDIUM\"",
        "targets": [
          {
            "provider": "ollama",
            "model": "deepseek-v4.1-flash",
            "weight": 1
          }
        ]
      },
      {
        "id": "router-complex",
        "name": "router-complex",
        "scope": "global",
        "priority": 3,
        "cel_expression": "virtual_key_name == \"router\" && complexity_tier == \"COMPLEX\"",
        "targets": [
          {
            "provider": "ollama",
            "model": "mistral-large-4",
            "weight": 1
          }
        ]
      }
    ]
  },
  "providers": {
    "ollama": {
      "keys": [
        {
          "name": "ollama-personal",
          "value": "env.OLLAMA_KEY_PERSONAL",
          "models": [
            "*"
          ],
          "weight": 1.0,
          "ollama_key_config": {
            "url": "http://MOCKIP:11434"
          }
        }
      ],
      "network_config": {
        "base_url": "http://MOCKIP:11434",
        "default_request_timeout_in_seconds": 30,
        "max_retries": 0,
        "allow_private_network": true
      }
    }
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "PGIP",
      "port": "5432",
      "user": "bifrost",
      "password": "bifrost",
      "db_name": "bifrost",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    }
  }
}