# Full configuration options can be found at https://developer.hashicorp.com/nomad/docs/configuration

datacenter = "localstack"
data_dir  = "/opt/nomad/data"
plugin_dir = "/usr/bin"
bind_addr = "0.0.0.0"

# Bind on every interface, but advertise ONE address explicitly.
#
# Without this block Nomad picks an interface at startup, and on this host it
# can pick podman0 (10.88.0.1). Workers read the advertised RPC address out of
# Consul and dial it, so they end up dialling their OWN podman bridge and the
# cluster silently loses every client while the HTTP API keeps answering.
#
# Observed 2026-07-31: unattended-upgrades patched openssl at 06:44:17 and
# restarted nomad one second later; that restart advertised RPC 10.88.0.1 and
# four of five nodes went down. The journal shows the two logged restarts split
# 1-1 between 192.168.2.30 and 10.88.0.1, so it is a coin flip on every restart,
# which is why restarting again used to "fix" it.
advertise {
  http = "{{ nomad_server_ip_address }}"
  rpc  = "{{ nomad_server_ip_address }}"
  serf = "{{ nomad_server_ip_address }}"
}

server {
  enabled          = true
  bootstrap_expect = 1

  # OIDC discovery issuer. Without this Nomad signs Workload Identity JWTs
  # and serves JWKS but advertises no /.well-known/openid-configuration, so
  # consumers that need a discovery document (MinIO identity_openid's
  # config_url, oauth2-proxy's bare-JWKS fallback) cannot be configured.
  # Nomad derives the discovery document's `issuer` and `jwks_uri` from this
  # value, and minted WI JWTs carry it as `iss`. Served over HTTPS through
  # the HAProxy edge (acl is_nomad at haproxy.hcl:101), reachable from any
  # cluster node. F1's docs/workload-identity.md defers discovery to F10;
  # this is the URL F10 owns and M1 points MinIO's config_url at.
  oidc_issuer = "{{ nomad_oidc_issuer }}"
}

acl {
  enabled = true
}

client {
  enabled = true

  options = {
    "driver.denylist" = "docker"
  }

  cni_path = "/opt/cni/bin"
  cni_config_dir = "/opt/cni/config"

}

consul {
  address = "{{ nomad_server_ip_address }}:8500"
  token   = "{{ nomad_server_consul_token_secret }}"
}

vault {
  enabled = true
  address = "http://{{ nomad_server_ip_address }}:8200"

  tls_skip_verify = true
  default_identity {
    aud = ["vault.io"]
    ttl = "1h"
  }
}

telemetry {
  publish_allocation_metrics = true
  publish_node_metrics       = true
  prometheus_metrics         = true
}

plugin "nomad-driver-podman" {
  config {
    volumes {
       enabled = true
       selinuxlabel = "z"
    }
  }
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}
