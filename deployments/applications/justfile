set shell := ["bash", "-uc"]

set dotenv-filename := "../../.devcontainer/.env"

alias i := init
alias a := apply
alias d := destroy

init:
    eval "$(localstack env)"
    terraform init -backend-config=./vars/backend-config.hcl

apply refresh="true" target="":
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(localstack env)"
    if [ -z "{{target}}" ]; then
        echo ">> No target specified, applying all resources"
        terraform apply -var-file=./vars/prod.tfvars -refresh={{refresh}}
    else
        echo ">> Applying target: {{target}}"
        terraform apply -var-file=./vars/prod.tfvars -refresh={{refresh}} -target={{target}}
    fi

destroy:
    eval "$(localstack env)"
    terraform destroy -var-file=./vars/prod.tfvars

state_rm resource:
    eval "$(localstack env)"
    terraform state rm {{resource}}

# Rebuild and push the custom Hermes image (Hermes base + Memex wheels).
# Tag is read from services.tf so the Dockerfile and Terraform stay in lockstep.
rebuild_hermes:
    #!/usr/bin/env bash
    set -euo pipefail
    tag=$(grep -E '^\s*hermes_version\s*=' services.tf | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
    image="ghcr.io/jasperhg90/hermes:${tag}"
    echo ">> building ${image}"
    echo "${GITHUB_WRITE_PAT}" | docker login ghcr.io -u "${GITHUB_USER}" --password-stdin
    docker build --pull --platform linux/arm64 -t "${image}" -f services/hermes/Dockerfile services/hermes
    docker push "${image}"

# Rebuild and push the dash (landing page) image.
# Tag is read from services.tf so the Dockerfile and Terraform stay in lockstep.
# Unlike rebuild_hermes, the build context is the REPO ROOT, not a
# services/<name>/ subdirectory: the app depends on cli/ via a uv path
# dependency, so both trees must be in the build. `just` pins this recipe's
# starting cwd to this justfile's own directory (deployments/applications/),
# never the repo root, so the explicit `cd` below is load-bearing -- without
# it the build context resolves to the wrong directory and `COPY cli/`
# fails in the Dockerfile.
rebuild_dash:
    #!/usr/bin/env bash
    set -euo pipefail
    tag=$(grep -E '^\s*dash_version\s*=' services.tf | head -1 | sed -E 's/.*"([^"]+)".*/\1/')
    image="ghcr.io/jasperhg90/dash:${tag}"
    echo ">> building ${image}"
    echo "${GITHUB_WRITE_PAT}" | docker login ghcr.io -u "${GITHUB_USER}" --password-stdin
    cd "$(git rev-parse --show-toplevel)"
    docker build --pull --platform linux/arm64 -t "${image}" -f deployments/applications/services/dash/Dockerfile .
    docker push "${image}"
