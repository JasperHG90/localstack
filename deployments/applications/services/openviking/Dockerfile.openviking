# OpenViking plus the Postgres vector backend and the hybrid retrieval
# wrapper, neither of which the upstream image can reach on its own.
#
# Build and push with the justfile beside this file:
#
#   just build
#   just push
#
# `storage.vectordb.backend` names `ov_postgres.adapter.PgVectorCollectionAdapter`
# as a dotted path. OpenViking resolves it with importlib at startup, so the
# package must be importable by the interpreter that runs the server or the
# backend simply does not exist. Neither ov-postgres nor psycopg is in the
# upstream image.
#
# BASE_IMAGE is passed by the justfile from the `openviking_base_image` line
# in services.tf, so what Terraform deploys and what this builds cannot drift.

ARG BASE_IMAGE=ghcr.io/volcengine/openviking:v0.4.17.1
FROM ${BASE_IMAGE}

# The venv at /app/.venv ships no pip and the image has no uv, so the system
# interpreter installs into the venv's site-packages with --target. Same shape
# as services/embark/Dockerfile.embark.
#
# Neither package is on PyPI; both install only from a git URL. The tags are
# pinned: `main` would make the image non-reproducible.
#
# ov-postgres-v0.4.0 and ov-retrieval-v0.2.0 are the same commit (3780884), and
# that is load-bearing rather than tidy. ov-retrieval's diversity pass reaches
# `pairwise_similarity` on the adapter through `getattr` and swallows its
# absence, so an older ov-postgres yields a server that starts clean and
# quietly ranks without the pass. Move the two pins together.
#
# Both carry OpenTelemetry spans as of this pin, and neither configures an
# exporter: they take the process-global TracerProvider OpenViking's server
# installs from ov.conf's observability.traces block. So the spans need no
# jobspec change to reach Tempo, and with tracing off they are non-recording
# and cost nothing. ov_retrieval's spans carry an `outcome` attribute naming
# why a hybrid pass declined to run, which is the one thing the Prometheus
# metrics cannot report -- see docs/retrieval-quality.md.
#
# The `#subdirectory=` fragment is required: the repository root is a uv
# workspace with no `[project]` table, so pip cannot build it. Re-check the
# fragment whenever the pin moves; it was forbidden up to ov-postgres-v0.2.0,
# which carried the package at the root instead.
#
# --no-deps, the same flag embark's Dockerfile documents at :32-33. Without it
# pip resolves ov-postgres's dependency tree and reinstalls openviking itself
# plus ~160 packages over the base image's locked venv, which un-pins an image
# whose whole purpose is a reproducible pin. ov_postgres needs openviking and
# pydantic, which the base image carries, plus psycopg and psycopg_pool, which
# RUN #2 supplies. Do not strip `pool` from RUN #2 as redundant: the adapter
# imports ConnectionPool at startup.
RUN /usr/local/bin/python3.13 -m pip install --no-deps --upgrade \
    --target /app/.venv/lib/python3.13/site-packages \
    "ov-postgres @ git+https://github.com/JasperHG90/openviking_extensions@ov-postgres-v0.5.0#subdirectory=packages/ov-postgres"

# Hybrid retrieval: an RRF keyword leg and an MMR diversity pass and reflection loop installed by
# the wrapper the jobspec starts instead of `openviking-server`.
#
# --no-deps holds here too. ov-retrieval declares openviking, pydantic and
# pydantic-settings; the base image carries all three, pydantic_settings
# included -- it is an `extra == "bot"` dependency of openviking and the image
# ships the bot. Verified in the published image, not assumed.
RUN /usr/local/bin/python3.13 -m pip install --no-deps --upgrade \
    --target /app/.venv/lib/python3.13/site-packages \
    "ov-ext @ git+https://github.com/JasperHG90/openviking_extensions@ov-ext-v0.5.0#subdirectory=packages/ov-ext"

# psycopg's binary wheel, so no libpq or compiler is needed at runtime, and
# the pool the adapter opens per collection.
RUN /usr/local/bin/python3.13 -m pip install --upgrade \
    --target /app/.venv/lib/python3.13/site-packages \
    "psycopg[binary,pool]==3.2.3"
