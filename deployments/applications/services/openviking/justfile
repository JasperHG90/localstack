set shell := ["bash", "-uc"]

set dotenv-filename := "../../../../.devcontainer/.env"

alias b := build
alias p := push
alias r := release

# The derived tag, from the ONE `openviking_image` line in services.tf, so the
# image this builds and the image Terraform deploys cannot drift.
#
# The grep tolerates a leading `#` so the image can still be built while the
# job is commented out.
_tag := ```
    grep -E '^\s*#?\s*openviking_image\s*=' ../../services.tf | head -1 | sed -E 's/.*"([^"]+)".*/\1/'
    ```

# The base is READ, not derived. embark computes its base by stripping
# `-jetson` from its own tag; here the base is a different repository
# (ghcr.io/volcengine) from the derived image (ghcr.io/jasperhg90), so no
# string surgery relates them. services.tf pins it on its own line and this
# reads that line, which is what makes the pin the artifact binding.
_base := ```
    grep -E '^\s*#?\s*openviking_base_image\s*=' ../../services.tf | head -1 | sed -E 's/.*"([^"]+)".*/\1/'
    ```

# Show what the recipes below would act on, without building anything.
show:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "derived image : {{ _tag }}"
    echo "base image    : {{ _base }}"

# Build the derived image: upstream OpenViking plus the Postgres backend.
#
# --platform linux/arm64 because it runs on radxa. --pull so the base is the
# current published one rather than a stale local copy; the pin makes that a
# digest check rather than a moving target.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    image="{{ _tag }}"
    base="{{ _base }}"
    if [ -z "${image}" ] || [ -z "${base}" ]; then
        echo "!! openviking_image or openviking_base_image is missing from services.tf" >&2
        exit 1
    fi
    if [[ "${base}" == *:latest ]]; then
        echo "!! openviking_base_image is :latest, which is not a pin. Use a version tag." >&2
        exit 1
    fi
    echo ">> building ${image}"
    echo ">>     from ${base}"
    docker build --pull --platform linux/arm64 \
        --build-arg "BASE_IMAGE=${base}" \
        -t "${image}" \
        -f Dockerfile.openviking .

# Nodes already authenticate to ghcr.io for pulls
# (bootstrap/playbooks/configure_podman.yml). This login is for the write.
push:
    #!/usr/bin/env bash
    set -euo pipefail
    image="{{ _tag }}"
    echo "${GITHUB_WRITE_PAT}" | docker login ghcr.io -u "${GITHUB_USER}" --password-stdin
    echo ">> pushing ${image}"
    docker push "${image}"

# Build and push in one go.
release: build push

# Does the adapter import? A wrong --target path or a python version bump in
# the base image breaks the dotted-path backend at OpenViking's startup, not
# at build time, so this is the check that catches it before deploy.
verify:
    #!/usr/bin/env bash
    set -euo pipefail
    image="{{ _tag }}"
    echo ">> inspecting ${image}"
    docker run --rm --platform linux/arm64 --entrypoint /app/.venv/bin/python "${image}" -c \
        "from ov_postgres.adapter import PgVectorCollectionAdapter as A; import psycopg; print('adapter', A.__name__); print('psycopg', psycopg.__version__)"
