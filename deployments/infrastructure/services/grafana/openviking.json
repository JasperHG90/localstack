    },
    {
      "id": 80,
      "type": "timeseries",
      "title": "Keyword pass: why it ran or did not (2h)",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 79},
      "timeFrom": "2h",
      "description": "The question the Prometheus funnel cannot answer. `fused` is the keyword leg doing its job; `no_keyword_hits` is a query nothing matched lexically; `backend_lacks_keyword_search` means the pass is not running at all, which is a silent downgrade to vector-only retrieval. Read from traces, not Prometheus. Tempo caps a TraceQL metrics query at a 3h range, so this panel is pinned to the last 2 hours and ignores the dashboard's time picker. For anything longer, use the Prometheus panels above.",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "traceql", "query": "{name=\"ov_retrieval.fuse_keywords\"} | count_over_time() by (span.ov_retrieval.outcome)", "refId": "A"}],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"lineWidth": 1, "fillOpacity": 20, "stacking": {"mode": "normal"}}},
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*backend_lacks.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*failed.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*fused.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}}
    },
    {
      "id": 81,
      "type": "timeseries",
      "title": "Diversity pass: why it ran or did not (2h)",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 79},
      "timeFrom": "2h",
      "description": "`diversified` is the MMR pass reordering results. `too_few_candidates` is normal on small result sets. `backend_lacks_similarity` means ov-postgres is too old to offer pairwise_similarity, so the pass is skipped and results are ranked without it while nothing errors. Read from traces, not Prometheus. Tempo caps a TraceQL metrics query at a 3h range, so this panel is pinned to the last 2 hours and ignores the dashboard's time picker. For anything longer, use the Prometheus panels above.",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "traceql", "query": "{name=\"ov_retrieval.diversify\"} | count_over_time() by (span.ov_retrieval.outcome)", "refId": "A"}],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"lineWidth": 1, "fillOpacity": 20, "stacking": {"mode": "normal"}}},
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*backend_lacks.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*failed.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*diversified.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}}
    },
    {
      "id": 82,
      "type": "timeseries",
      "title": "pgvector p95 by operation (2h)",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 79},
      "timeFrom": "2h",
      "description": "Every query ov-postgres issues, timed at the span. openviking_operation_duration_seconds times the whole retrieval; this says which SQL inside it was slow. Read from traces, not Prometheus. Tempo caps a TraceQL metrics query at a 3h range, so this panel is pinned to the last 2 hours and ignores the dashboard's time picker. For anything longer, use the Prometheus panels above.",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "traceql", "query": "{name=~\"ov_postgres.*\"} | quantile_over_time(duration, .95) by (name)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "fillOpacity": 0}}},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}}
    },
    {
      "id": 83,
      "type": "timeseries",
      "title": "Keyword hits per retrieval (2h)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 87},
      "timeFrom": "2h",
      "description": "How many URIs the keyword leg actually contributed to the fusion. Zero across the board with the pass enabled means the RRF fusion is running on one leg. This aggregates a span attribute's VALUE, which is the thing span-metrics cannot do and the reason this reads from traces. Read from traces, not Prometheus. Tempo caps a TraceQL metrics query at a 3h range, so this panel is pinned to the last 2 hours and ignores the dashboard's time picker. For anything longer, use the Prometheus panels above.",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "traceql", "query": "{name=\"ov_retrieval.fuse_keywords\"} | avg_over_time(span.ov_retrieval.keyword_hits)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1, "custom": {"lineWidth": 1, "fillOpacity": 10}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 84,
      "type": "timeseries",
      "title": "Rows per pgvector search (2h)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 87},
      "timeFrom": "2h",
      "description": "Rows the vector search returned per query. Read beside the zero-result ratio: rows going to zero while retrievals continue is the empty-or-wrongly-scoped-collection case OpenVikingNoCandidates alerts on, seen at the SQL rather than inferred from the funnel. Read from traces, not Prometheus. Tempo caps a TraceQL metrics query at a 3h range, so this panel is pinned to the last 2 hours and ignores the dashboard's time picker. For anything longer, use the Prometheus panels above.",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "targets": [{"queryType": "traceql", "query": "{name=\"ov_postgres.search_by_vector\"} | avg_over_time(span.ov_postgres.rows)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "custom": {"lineWidth": 1, "fillOpacity": 10}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
